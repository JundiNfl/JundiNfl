<script>
  // Tema terang/gelap
  const root = document.documentElement;
  const btn = document.getElementById('themeBtn');
  let saved = null;
  try { saved = localStorage.getItem('theme'); } catch (e) {}
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  function setTheme(t) {
    root.setAttribute('data-theme', t);
    btn.textContent = t === 'dark' ? '☀️' : '🌙';
    try { localStorage.setItem('theme', t); } catch (e) {}
  }
  setTheme(saved || (prefersDark ? 'dark' : 'light'));
  btn.addEventListener('click', () => setTheme(root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'));

  // Tandai menu sesuai bagian yang sedang dilihat
  const links = document.querySelectorAll('.nav ul a');
  const map = new Map();
  links.forEach(a => { const s = document.querySelector(a.getAttribute('href')); if (s) map.set(s, a); });
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        links.forEach(l => l.classList.remove('active'));
        map.get(e.target).classList.add('active');
      }
    });
  }, { rootMargin: '-45% 0px -50% 0px' });
  map.forEach((_, s) => io.observe(s));
</script>
