<style>
  :root {
    --bg: #F6F8F5;
    --surface: #FFFFFF;
    --ink: #10231F;
    --muted: #4F6560;
    --line: #D6E0DB;
    --green: #0F5C50;
    --green-soft: #DCEEE8;
    --gold: #F2B632;
    --gold-ink: #10231F;
    --radius: 18px;
  }
  [data-theme="dark"] {
    --bg: #0B1714;
    --surface: #12241F;
    --ink: #E9F2EF;
    --muted: #9DB5AE;
    --line: #234038;
    --green: #5FD0B8;
    --green-soft: #17342D;
    --gold: #F2B632;
    --gold-ink: #10231F;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; scroll-padding-top: 84px; }
  body {
    font-family: 'Figtree', system-ui, sans-serif;
    background: var(--bg);
    color: var(--ink);
    line-height: 1.65;
    font-size: 1.05rem;
    transition: background .3s, color .3s;
  }
  h1, h2, h3 { font-family: 'Bricolage Grotesque', 'Figtree', sans-serif; line-height: 1.08; letter-spacing: -0.02em; }
  a { color: inherit; }
  :focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; border-radius: 6px; }

  .wrap { width: min(1080px, 100% - 40px); margin-inline: auto; }

  /* ---------- Navbar ---------- */
  header.nav {
    position: sticky; top: 0; z-index: 20;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .nav .wrap { display: flex; align-items: center; justify-content: space-between; height: 66px; gap: 16px; }
  .logo {
    font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 1.15rem;
    text-decoration: none; display: flex; align-items: center; gap: 10px;
  }
  .logo i {
    font-style: normal; width: 34px; height: 34px; border-radius: 50% 50% 8px 8px;
    background: var(--gold); color: var(--gold-ink); display: grid; place-items: center; font-size: .95rem;
  }
  .nav ul { display: flex; gap: 4px; list-style: none; }
  .nav ul a {
    text-decoration: none; padding: 8px 14px; border-radius: 999px; font-weight: 500; font-size: .96rem;
    color: var(--muted); transition: background .2s, color .2s;
  }
  .nav ul a:hover { color: var(--ink); background: var(--green-soft); }
  .nav ul a.active { color: var(--ink); background: var(--green-soft); }
  .theme-btn {
    width: 42px; height: 42px; border-radius: 50%; border: 1px solid var(--line);
    background: var(--surface); color: var(--ink); cursor: pointer; font-size: 1.1rem; flex-shrink: 0;
  }
  .theme-btn:hover { border-color: var(--green); }

  /* ---------- Hero ---------- */
  .hero { padding: 72px 0 96px; }
  .hero .wrap { display: grid; grid-template-columns: 1.15fr .85fr; gap: 56px; align-items: center; }
  .hero h1 { font-size: clamp(2.8rem, 7vw, 5.2rem); font-weight: 800; }
  .hero .role {
    margin-top: 22px; font-size: 1.2rem; color: var(--muted); max-width: 30em;
  }
  .hero .role b { color: var(--ink); font-weight: 600; }
  .focus { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }
  .focus span {
    padding: 8px 16px; border-radius: 999px; background: var(--green-soft); color: var(--green);
    font-weight: 600; font-size: .95rem;
  }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }
  .btn {
    display: inline-flex; align-items: center; gap: 8px; padding: 14px 24px; border-radius: 999px;
    font-weight: 600; text-decoration: none; border: 2px solid transparent; font-size: 1rem;
    transition: transform .2s, background .2s, border-color .2s;
  }
  .btn:hover { transform: translateY(-2px); }
  .btn.primary { background: var(--gold); color: var(--gold-ink); }
  .btn.ghost { border-color: var(--line); background: var(--surface); }
  .btn.ghost:hover { border-color: var(--green); }

  .portrait { position: relative; justify-self: center; width: min(360px, 100%); aspect-ratio: 4 / 5; }
  .portrait::before {
    content: ""; position: absolute; inset: 0; transform: translate(18px, 18px);
    border: 3px solid var(--gold); border-radius: 999px 999px 28px 28px;
  }
  .portrait .frame {
    position: relative; width: 100%; height: 100%; overflow: hidden;
    border-radius: 999px 999px 28px 28px; background: var(--green);
    display: grid; place-items: center;
  }
  .portrait img { width: 100%; height: 100%; object-fit: cover; display: block; position: absolute; inset: 0; }
  .portrait .initials {
    font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 6rem; color: var(--gold);
  }

  /* Satu momen animasi: hero muncul saat halaman dibuka */
  @media (prefers-reduced-motion: no-preference) {
    .hero-in { opacity: 0; transform: translateY(18px); animation: rise .7s cubic-bezier(.2,.7,.2,1) forwards; }
    .hero-in:nth-child(2) { animation-delay: .12s; }
    .hero-in:nth-child(3) { animation-delay: .24s; }
    .hero-in:nth-child(4) { animation-delay: .36s; }
    .portrait { opacity: 0; animation: rise .9s .2s cubic-bezier(.2,.7,.2,1) forwards; }
    @keyframes rise { to { opacity: 1; transform: none; } }
  }

  /* ---------- Sections ---------- */
  section.block { padding: 84px 0; border-top: 1px solid var(--line); }
  section.block .wrap { display: grid; grid-template-columns: 260px 1fr; gap: 48px; }
  section.block h2 { font-size: clamp(1.9rem, 3.4vw, 2.6rem); font-weight: 700; position: sticky; top: 100px; align-self: start; }

  .about p { font-size: 1.25rem; line-height: 1.7; max-width: 36em; }
  .edu { margin-top: 36px; display: grid; gap: 14px; }
  .edu-item {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 20px 24px; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; align-items: center;
