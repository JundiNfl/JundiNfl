  .edu-item strong { font-family: 'Bricolage Grotesque', sans-serif; font-size: 1.2rem; display: block; }
  .edu-item span { color: var(--muted); }
  .edu-item time { font-weight: 600; color: var(--green); }

  .skill-group + .skill-group { margin-top: 30px; }
  .skill-group h3 { font-size: 1.15rem; margin-bottom: 14px; color: var(--muted); font-weight: 600; font-family: 'Figtree', sans-serif; letter-spacing: 0; }
  .chips { display: flex; flex-wrap: wrap; gap: 12px; }
  .chip {
    padding: 14px 22px; background: var(--surface); border: 1px solid var(--line); border-radius: 14px;
    font-weight: 600; transition: border-color .2s, transform .2s;
  }
  .chip:hover { border-color: var(--green); transform: translateY(-2px); }

  /* Linimasa pengalaman (urutan waktu yang nyata) */
  .timeline { list-style: none; position: relative; padding-left: 34px; }
  .timeline::before { content: ""; position: absolute; left: 7px; top: 8px; bottom: 8px; width: 2px; background: var(--line); }
  .timeline li { position: relative; padding-bottom: 34px; }
  .timeline li:last-child { padding-bottom: 0; }
  .timeline li::before {
    content: ""; position: absolute; left: -34px; top: 6px; width: 16px; height: 16px; border-radius: 50%;
    background: var(--bg); border: 3px solid var(--green);
  }
  .timeline li.now::before { background: var(--gold); border-color: var(--gold); box-shadow: 0 0 0 6px color-mix(in srgb, var(--gold) 30%, transparent); }
  .timeline time { font-weight: 600; color: var(--green); font-size: .95rem; }
  .timeline h3 { font-size: 1.4rem; margin: 2px 0 2px; font-weight: 700; }
  .timeline p { color: var(--muted); }

  /* Project */
  .project {
    display: grid; grid-template-columns: 1fr 1fr; background: var(--surface);
    border: 1px solid var(--line); border-radius: 24px; overflow: hidden;
  }
  .project .shot { background: var(--green); padding: 36px 32px; display: grid; place-items: center; }
  .browser { width: 100%; background: var(--bg); border-radius: 12px; overflow: hidden; box-shadow: 0 18px 40px rgba(0,0,0,.25); }
  .browser .bar { display: flex; gap: 6px; padding: 10px 12px; background: var(--green-soft); }
  .browser .bar i { width: 9px; height: 9px; border-radius: 50%; background: var(--muted); opacity: .5; }
  .browser .body { padding: 18px; display: grid; gap: 10px; }
  .browser .body div { height: 10px; border-radius: 6px; background: var(--line); }
  .browser .body .h { height: 22px; width: 62%; background: var(--green); }
  .browser .body .g { height: 56px; background: var(--gold); width: 100%; }
  .browser .body .s { width: 80%; }
  .project .info { padding: 36px 32px; display: flex; flex-direction: column; justify-content: center; gap: 14px; align-items: flex-start; }
  .project h3 { font-size: 1.7rem; }
  .project p { color: var(--muted); }

  /* Kontak */
  .contact { padding: 84px 0 56px; }
  .contact-card {
    background: var(--green); color: #fff; border-radius: 28px; padding: clamp(32px, 6vw, 64px);
  }
  [data-theme="dark"] .contact-card { background: var(--green-soft); color: var(--ink); }
  .contact-card h2 { font-size: clamp(2rem, 5vw, 3.4rem); font-weight: 800; max-width: 12em; }
  .contact-card p { margin-top: 14px; opacity: .85; max-width: 32em; }
  .links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .links a {
    padding: 12px 22px; border-radius: 999px; text-decoration: none; font-weight: 600;
    background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.3); transition: background .2s, transform .2s;
  }
  [data-theme="dark"] .links a { background: var(--surface); border-color: var(--line); }
  .links a:hover { background: var(--gold); color: var(--gold-ink); border-color: var(--gold); transform: translateY(-2px); }
  footer { text-align: center; color: var(--muted); font-size: .92rem; padding: 12px 0 40px; }

  /* ---------- Responsive ---------- */
